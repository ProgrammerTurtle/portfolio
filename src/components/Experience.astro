---
import { experience } from '../data/site';
import Rail from './Rail.astro';
import SectionHead from './SectionHead.astro';
---
<section class="block" id="experience">
  <Rail />
  <div class="wrap">
    <SectionHead title="Experience" />
    <div class="log">
      {experience.map((x) => (
        <div class="log-entry">
          <div class="mono log-when">{x.when}</div>
          <div>
            <h3>{x.role}</h3>
            <p class="org">{x.org}</p>
            <ul>{x.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
