---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Chips from './Chips.astro';
import Icon from './Icon.astro';
import NewTab from './NewTab.astro';
import Rail from './Rail.astro';
import SectionHead from './SectionHead.astro';
import { GITHUB } from '../data/site';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = all.find((p) => p.data.featured);
const rest = all.filter((p) => !p.data.featured);
const repoUrl = (repo?: string) => (repo ? `${GITHUB}/${repo}` : undefined);

const FeaturedBody = featured ? (await render(featured)).Content : null;
const rows = await Promise.all(rest.map(async (p) => ({ p, Content: (await render(p)).Content })));
---
<section class="block dark" id="projects">
  <Rail kind="origin" />
  <div class="wrap">
    <SectionHead title="Projects">
      <p>Everything here is open source. Each project links to its GitHub repo.</p>
    </SectionHead>

    {featured && FeaturedBody && (
      <article class="featured">
        <div class="featured-art">
          {featured.data.image && (
            <Image src={featured.data.image} alt={featured.data.imageAlt ?? featured.data.name} widths={[640, 960, 1300]} sizes="(max-width: 880px) 100vw, 620px" />
          )}
          {/* Mouse shortcut to the repo; the button below is the real link, so this stays out of the tab order and the reading order. */}
          <a class="art-link" href={repoUrl(featured.data.repo)} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true"></a>
          {featured.data.flag && <span class="badge">{featured.data.flag}</span>}
        </div>
        <div class="featured-body">
          <h3>{featured.data.name}</h3>
          <p class="sub">{featured.data.kicker}</p>
          <FeaturedBody />
          {featured.data.detail && <p class="detail">{featured.data.detail}</p>}
          <Chips chips={featured.data.chips} />
          {featured.data.repo && (
            <div class="go">
              <a class="btn" href={repoUrl(featured.data.repo)} target="_blank" rel="noopener">View on GitHub <Icon name="arrow-up-right" /><NewTab /></a>
            </div>
          )}
        </div>
      </article>
    )}

    <ul class="manifest">
      {rows.map(({ p, Content }) => {
        const href = repoUrl(p.data.repo);
        return (
          <li class="row" data-cat={p.data.cat}>
            <div class:list={['thumb', { tile: !p.data.image }]}>
              {p.data.image ? (
                <Image src={p.data.image} alt={p.data.imageAlt ?? ''} widths={[320, 640]} sizes="(max-width: 860px) 96px, 560px" />
              ) : p.data.tile && (
                <div aria-hidden="true">
                  <b>{p.data.tile.value}</b>
                  <span>{p.data.tile.label}</span>
                </div>
              )}
              {/* Mouse shortcut to the repo; the GitHub button is the real, focusable link. */}
              {href && <a class="thumb-link" href={href} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true"></a>}
            </div>
            <div class="head">
              <h3>{p.data.name}</h3>
              <p class="sub">{p.data.kicker}</p>
            </div>
            <div class="body">
              {p.data.summary && <p class="summary">{p.data.summary}</p>}
              <Chips chips={p.data.chips} />
              <details class="more">
                <summary><span class="closed">Details</span><span class="opened">Less</span><span class="sr-only"> about {p.data.name}</span><Icon name="chevron-down" /></summary>
                <div class="more-body">
                  <Content />
                  {p.data.note && <p class="note">{p.data.note}</p>}
                </div>
              </details>
            </div>
            {href && (
              <a class="repo" href={href} target="_blank" rel="noopener">
                GitHub <Icon name="arrow-up-right" /><span class="sr-only"> repo for {p.data.name}</span><NewTab />
              </a>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</section>
