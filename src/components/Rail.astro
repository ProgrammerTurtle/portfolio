// down each later section, and "turn" becomes the footer bands.
interface Props { kind?: 'origin' | 'turn' }
const { kind } = Astro.props;
---
<div class:list={['rail', kind]} aria-hidden="true"><i></i><i></i><i></i><i></i></div>
